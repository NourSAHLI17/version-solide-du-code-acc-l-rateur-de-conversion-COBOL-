{
    "normalize_whitespace": true,
    "stdout_tolerance": {
        "default_numeric_tolerance_pct": 0.001,
        "exact_fields": [
            "LOANS="
        ],
        "tolerant_fields": {
            "AMT=": 0.0001
        },
        "ignore_fields": [
            "RPTMONTH v",
            "START 20",
            "date",
            "RUN TIMESTAMP",
            "PAGE NUMBER",
            "BATCH ID"
        ]
    },
    "generated_files_tolerance": {}
}
