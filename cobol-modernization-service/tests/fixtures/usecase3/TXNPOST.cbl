       IDENTIFICATION DIVISION.
       PROGRAM-ID. TXNPOST.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUSTOMER-FILE
               ASSIGN TO 'ACME.CUSTOMER.MASTER'
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS CUST-ID
               FILE STATUS IS WS-CUST-STATUS.
           SELECT TRANSACTION-FILE
               ASSIGN TO 'ACME.TRANSACTIONS'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-TXN-STATUS.
           SELECT REPORT-FILE
               ASSIGN TO 'ACME.POST.REPORT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-RPT-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD CUSTOMER-FILE.
       01 CUSTOMER-RECORD.
          COPY CUSTCOPY.
       FD TRANSACTION-FILE.
       01 TRANSACTION-RECORD.
          COPY TXNCOPY.
       FD REPORT-FILE.
       01 REPORT-LINE.
          COPY RPTCOPY.
       WORKING-STORAGE SECTION.
       01 WS-CUST-STATUS        PIC XX VALUE '00'.
       01 WS-TXN-STATUS         PIC XX VALUE '00'.
       01 WS-RPT-STATUS         PIC XX VALUE '00'.
       01 WS-EOF-FLAG           PIC X  VALUE 'N'.
       01 WS-POSTED-COUNT       PIC 9(5) VALUE ZEROS.
       01 WS-FAILED-COUNT       PIC 9(5) VALUE ZEROS.
       01 WS-ERROR-AREA.
          COPY ERRORCOPY.
       01 WS-RETURN-CODE.
          05 WS-RC-STATUS          PIC XX VALUE '00'.
          88 RC-SUCCESS            VALUE '00'.
       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 0200-OPEN-FILES
           IF NOT RC-SUCCESS
               MOVE 'FILE OPEN FAILED' TO ERR-MESSAGE
               PERFORM 9100-WRITE-ERROR-LINE
               STOP RUN
           END-IF
           PERFORM 1000-WRITE-HEADER
           PERFORM 2000-PROCESS-TRANSACTIONS
               UNTIL WS-EOF-FLAG = 'Y'
           PERFORM 3000-WRITE-SUMMARY
           PERFORM 0300-CLOSE-FILES
           STOP RUN.
       0200-OPEN-FILES.
           OPEN I-O  CUSTOMER-FILE
           OPEN INPUT TRANSACTION-FILE
           OPEN OUTPUT REPORT-FILE
           MOVE WS-RPT-STATUS TO WS-RC-STATUS.
       0300-CLOSE-FILES.
           CLOSE CUSTOMER-FILE
           CLOSE TRANSACTION-FILE
           CLOSE REPORT-FILE.
       1000-WRITE-HEADER.
           MOVE "TRANSACTION POSTING REPORT" TO RPT-LINE-TEXT
           WRITE REPORT-LINE.
       2000-PROCESS-TRANSACTIONS.
           READ TRANSACTION-FILE NEXT
               AT END MOVE 'Y' TO WS-EOF-FLAG
               NOT AT END PERFORM 2100-POST-TRANSACTION.
       2100-POST-TRANSACTION.
           MOVE TXN-CUST-ID TO CUST-ID
           READ CUSTOMER-FILE KEY IS CUST-ID
               INVALID KEY
                   ADD 1 TO WS-FAILED-COUNT
                   PERFORM 2200-LOG-FAILED
               NOT INVALID KEY
                   COMPUTE CUST-BALANCE = CUST-BALANCE + TXN-AMOUNT
                   REWRITE CUSTOMER-RECORD
                       INVALID KEY PERFORM 2200-LOG-FAILED
                   NOT INVALID KEY
                       ADD 1 TO WS-POSTED-COUNT.
       2200-LOG-FAILED.
           MOVE TXN-CUST-ID TO RPT-LINE-TEXT(1:10)
           MOVE "FAILED"    TO RPT-LINE-TEXT(11:6)
           WRITE REPORT-LINE.
       3000-WRITE-SUMMARY.
           MOVE "POSTED:  "      TO RPT-LINE-TEXT(1:9)
           MOVE WS-POSTED-COUNT  TO RPT-LINE-TEXT(10:5)
           WRITE REPORT-LINE
           MOVE "FAILED:  "      TO RPT-LINE-TEXT(1:9)
           MOVE WS-FAILED-COUNT  TO RPT-LINE-TEXT(10:5)
           WRITE REPORT-LINE.
       9100-WRITE-ERROR-LINE.
           MOVE ERR-MESSAGE TO RPT-LINE-TEXT
           WRITE REPORT-LINE.
