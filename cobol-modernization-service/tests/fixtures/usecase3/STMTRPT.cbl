       IDENTIFICATION DIVISION.
       PROGRAM-ID. STMTRPT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUSTOMER-FILE
               ASSIGN TO 'ACME.CUSTOMER.MASTER'
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS CUST-ID
               FILE STATUS IS WS-FILE-STATUS.
           SELECT REPORT-FILE
               ASSIGN TO 'ACME.STMT.REPORT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-RPT-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD CUSTOMER-FILE.
       01 CUSTOMER-RECORD.
          COPY CUSTCOPY.
       FD REPORT-FILE.
       01 REPORT-LINE.
          COPY RPTHDCPY.
       WORKING-STORAGE SECTION.
       01 WS-FILE-STATUS        PIC XX VALUE '00'.
       01 WS-RPT-STATUS         PIC XX VALUE '00'.
       01 WS-EOF-FLAG           PIC X  VALUE 'N'.
       01 WS-RECORD-COUNT       PIC 9(5) VALUE ZEROS.
       01 WS-GRAND-TOTAL        PIC S9(9)V99 COMP-3 VALUE ZEROS.
       01 WS-GRAND-TOTAL-OUT    PIC Z(11)9.99.
       01 WS-ERROR-AREA.
          COPY ERRORCOPY.
       01 WS-RETURN-CODE.
          05 WS-RC-STATUS          PIC XX VALUE '00'.
          88 RC-SUCCESS            VALUE '00'.
       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 0100-OPEN-FILES
           IF NOT RC-SUCCESS
               MOVE 'FILE OPEN FAILED' TO ERR-MESSAGE
               STOP RUN
           END-IF
           PERFORM 1000-WRITE-HEADER
           PERFORM 2000-PROCESS-CUSTOMERS
               UNTIL WS-EOF-FLAG = 'Y'
           PERFORM 0200-WRITE-GRAND-TOTALS
           CLOSE CUSTOMER-FILE
           CLOSE REPORT-FILE
           STOP RUN.
       0100-OPEN-FILES.
           OPEN INPUT CUSTOMER-FILE
           OPEN OUTPUT REPORT-FILE
           MOVE WS-RPT-STATUS TO WS-RC-STATUS.
       1000-WRITE-HEADER.
           MOVE 1 TO RPT-PAGE-NO
           MOVE "2026-05-19" TO RPT-DATE
           MOVE "CUSTOMER STATEMENT REPORT" TO RPT-TITLE
           MOVE RPT-TITLE TO RPT-HEADER-1
           MOVE ALL "-" TO RPT-SEPARATOR
           MOVE RPT-HEADER-1 TO RPT-LINE-TEXT
           WRITE REPORT-LINE.
       2000-PROCESS-CUSTOMERS.
           READ CUSTOMER-FILE NEXT
               AT END MOVE 'Y' TO WS-EOF-FLAG
               NOT AT END
                   IF CUST-STATUS = 'A'
                       ADD 1 TO WS-RECORD-COUNT
                       ADD CUST-BALANCE TO WS-GRAND-TOTAL
                       PERFORM 2100-FORMAT-CUSTOMER-LINE
                   END-IF.
       2100-FORMAT-CUSTOMER-LINE.
           MOVE CUST-ID   TO RPT-LINE-TEXT(1:10)
           MOVE CUST-NAME TO RPT-LINE-TEXT(11:30)
           WRITE REPORT-LINE.
       0200-WRITE-GRAND-TOTALS.
           MOVE WS-GRAND-TOTAL TO WS-GRAND-TOTAL-OUT
           MOVE "GRAND TOTAL: " TO RPT-LINE-TEXT(1:14)
           MOVE WS-GRAND-TOTAL-OUT TO RPT-LINE-TEXT(15:25)
           WRITE REPORT-LINE
           MOVE "TOTAL RECORDS: " TO RPT-LINE-TEXT(1:16)
           MOVE WS-RECORD-COUNT TO RPT-LINE-TEXT(17:5)
           WRITE REPORT-LINE
           MOVE "END OF REPORT" TO RPT-FOOTER
           MOVE RPT-FOOTER TO RPT-LINE-TEXT
           WRITE REPORT-LINE.
