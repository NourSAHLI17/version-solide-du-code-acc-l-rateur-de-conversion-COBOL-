       IDENTIFICATION DIVISION.
       PROGRAM-ID. STMTRPT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUSTOMER-FILE
               ASSIGN TO 'ACME.CUSTOMER.MASTER'
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-FILE-STATUS.
           SELECT REPORT-FILE
               ASSIGN TO 'ACME.STMT.REPORT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-RPT-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD CUSTOMER-FILE.
       01 CUSTOMER-RECORD.
          COPY CUSTCOPY.
       FD REPORT-FILE.
       01 REPORT-LINE.
          COPY RPTCOPY.
       WORKING-STORAGE SECTION.
       01 WS-FILE-STATUS        PIC XX VALUE '00'.
       01 WS-RPT-STATUS         PIC XX VALUE '00'.
       01 WS-EOF-FLAG           PIC X  VALUE 'N'.
       01 WS-RECORD-COUNT       PIC 9(5) VALUE ZEROS.
       01 WS-FILLER-AREA.
          05 FILLER              PIC X(10) VALUE SPACES.
          05 FILLER              PIC X(10) VALUE SPACES.
          05 FILLER              PIC X(10) VALUE SPACES.
       77 WS-PAD-01             PIC X VALUE SPACE.
       77 WS-PAD-02             PIC X VALUE SPACE.
       PROCEDURE DIVISION.
       0000-MAIN.
           OPEN INPUT CUSTOMER-FILE.
           OPEN OUTPUT REPORT-FILE.
           PERFORM 1000-WRITE-HEADER.
           PERFORM 2000-PROCESS-CUSTOMERS
               UNTIL WS-EOF-FLAG = 'Y'.
           PERFORM 3000-WRITE-FOOTER.
           CLOSE CUSTOMER-FILE.
           CLOSE REPORT-FILE.
           STOP RUN.
       1000-WRITE-HEADER.
           MOVE "CUSTOMER STATEMENT REPORT" TO RPT-LINE-TEXT.
           WRITE REPORT-LINE.
       2000-PROCESS-CUSTOMERS.
           READ CUSTOMER-FILE NEXT
               AT END MOVE 'Y' TO WS-EOF-FLAG
               NOT AT END
                   ADD 1 TO WS-RECORD-COUNT
                   PERFORM 2100-FORMAT-CUSTOMER-LINE.
       2100-FORMAT-CUSTOMER-LINE.
           MOVE CUST-ID   TO RPT-LINE-TEXT(1:10).
           MOVE CUST-NAME TO RPT-LINE-TEXT(11:30).
           WRITE REPORT-LINE.
       3000-WRITE-FOOTER.
           MOVE "TOTAL RECORDS: " TO RPT-LINE-TEXT(1:15).
           MOVE WS-RECORD-COUNT   TO RPT-LINE-TEXT(16:5).
           WRITE REPORT-LINE.
