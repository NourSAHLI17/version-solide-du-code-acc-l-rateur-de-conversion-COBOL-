# EY Azure OpenAI — primary gpt-4o
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://eyq-incubator.europe.fabric.ey.com/eyq/eu/api
OPENAI_API_VERSION=2024-02-15-preview
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FALLBACK=gpt-4.1-mini

# Optional: deployment name if Fabric id differs from model id
# OPENAI_DEPLOYMENT_NAME=gpt-4o

# Analysis uses LLM (not deterministic-only)
ANALYSIS_ENGINE=llm

# API server
PORT=8000
HOST=0.0.0.0
